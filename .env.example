APP_NAME=NEXUS Research
APP_VERSION=2.0.0
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI-compatible model provider
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Optional integrations
TAVILY_API_KEY=
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# Zero-Docker local database
DATABASE_DRIVER=sqlite
SQLITE_PATH=app/data/nexus_demo.db

# Optional MySQL configuration
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=nexus_research
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

MAX_UPLOAD_MB=20

# Authentication and persistent application data
APP_DATABASE_PATH=app/data/nexus_app.db
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_HOURS=24
AUTH_ALLOW_REGISTRATION=true
ADMIN_EMAIL=admin@nexus.local
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=NEXUS 管理员
